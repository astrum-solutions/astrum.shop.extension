{
  "manifest_version": 3,
  "name": "astrum.shop",
  "version": "1.0.0",
  "description": "Передаёт сессию Claude, ChatGPT или Grok в ваш заказ на astrum.shop — только по вашему нажатию.",
  "homepage_url": "https://github.com/astrum-solutions/astrum.shop.extension",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "astrum.shop",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "scripts": ["protocol.js", "services.js", "reader.js", "router.js", "background.js"]
  },
  "permissions": ["cookies", "scripting"],
  "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*", "https://grok.com/*", "https://astrum.shop/*"],
  "content_scripts": [
    {
      "matches": ["https://astrum.shop/*"],
      "js": ["protocol.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@astrum.shop",
      "strict_min_version": "128.0"
    }
  }
}
