{
  "manifest_version": 3,
  "name": "astrum.shop",
  "version": "1.1.0",
  "description": "Передаёт сессию Claude, ChatGPT, Grok или Higgsfield в ваш заказ на astrum.shop — только по вашему нажатию.",
  "homepage_url": "https://github.com/astrum-solutions/astrum.shop.extension",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "astrum.shop",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["cookies", "scripting"],
  "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*", "https://grok.com/*", "https://higgsfield.ai/*", "https://astrum.shop/*"],
  "content_scripts": [
    {
      "matches": ["https://astrum.shop/*"],
      "js": ["protocol.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
